# Client reporting portal (/clients). Set these in Vercel > Project > Settings > Environment Variables.
# Never commit real values.

# NextAuth
NEXTAUTH_URL=https://fpnapeople.io
NEXTAUTH_SECRET=            # random 32+ character string

# Microsoft Entra External ID tenant: FPnA Client Portal (fpnaclients)
CIAM_TENANT_SUBDOMAIN=fpnaclients
CIAM_TENANT_ID=44ad4783-39f6-4c3f-abf0-a3d8610a7952
CIAM_CLIENT_ID=             # app registration "FPnA Client Portal Web" in the fpnaclients tenant
CIAM_CLIENT_SECRET=

# Power BI service principal: "BB Reporting Portal" in the FPnA People tenant
PBI_TENANT_ID=b502dd68-930d-4140-922e-8a38ff2ffda4
PBI_CLIENT_ID=cf96be43-9c06-4264-9059-94c90b013ec6
PBI_CLIENT_SECRET=
